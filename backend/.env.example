# Flask 세션 암호화용 (아무 임의 문자열)
SECRET_KEY=your-flask-secret-key

# Supabase — 대시보드 → Project Settings → API Keys → "Publishable and secret API keys" 탭
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...   # secret key (백엔드 전용, RLS 우회 / 절대 노출 금지)

# OpenAI (AI 파트 전용. 없으면 비워둬도 부팅됨)
OPENAI_API_KEY=

# CORS 허용 출처 (프론트 주소)
CORS_ORIGINS=http://localhost:3000,https://meeting-hub-ai.netlify.app

# macOS에서 5000 포트가 AirPlay와 충돌하면 주석 해제
# PORT=5001
